NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Asistan - Gemini arac cagirma (/api/chat).
# SUNUCU tarafi degisken: NEXT_PUBLIC_ ONEKI KULLANMA, yoksa anahtar
# tarayiciya gonderilen JS paketine gomulur ve herkese acik olur.
# Anahtar: https://aistudio.google.com/apikey
# Bos birakilirsa asistan devre disi kalir, uygulamanin geri kalani
# normal calisir (/api/chat 503 doner).
GEMINI_API_KEY=

# E2E testleri (opsiyonel) - korumali sayfalarin Playwright testleri.
# Supabase'de GERCEKTEN var olan bir test hesabi (bir kez elle kaydol).
# Kisisel hesabini KULLANMA: testler islem ekleyip silebilir.
# Tanimli degilse korumali sayfa testleri atlanir, erisilebilirlik
# testleri normal kosar.
# E2E_EMAIL=
# E2E_PASSWORD=
